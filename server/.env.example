# Copy to server/.env for local development. Real environment variables win.
DATABASE_URL=sqlite:///./viaduct.db
SEED_ON_START=1
START_BALANCE_CENTS=250000
CREDIT_CEILING_CENTS=500000
RATE_LIMIT_PER_MINUTE=20
PEER_ONLINE_SECONDS=180

# PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
PUBLIC_BASE_URL=http://localhost:8000

# OpenAI-compatible chat endpoint (OpenAI, Groq, OpenRouter, Together…)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-nano
